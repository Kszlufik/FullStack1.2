{{> menu active="about"}}

<section class="hero is-primary is-bold">
  <div class="hero-body has-text-centered">
    <h1 class="title is-2">Welcome to Playtime</h1>
    <p class="subtitle is-4">Your ultimate trip organizer and adventure planner!</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="columns is-vcentered">
      <div class="column is-half">
        <h2 class="title is-3">Discover. Organize. Explore.</h2>
        <p class="content">
          Playtime helps you organize and manage your trips effortlessly. Whether you're planning a hike, a city tour, or an outdoor adventure, 
          our platform allows you to mark interesting locations, share your favorite spots, and explore new destinations with ease.
        </p>
        <p class="content">
          Add points of interest, upload photos, and keep track of your travels—all in one place!
        </p>
      </div>
      <div class="column is-half has-text-centered">
        <span class="icon is-large">
          <i class="fas fa-map-marked-alt fa-7x" style="color:rgb(0, 255, 76)"></i>
        </span>
        <span class="icon is-large">
          <i class="fas fa-route fa-6x" style="color:deepskyblue"></i>
        </span>
        <span class="icon is-large">
          <i class="fas fa-globe fa-7x" style="color:rgb(255, 68, 0)"></i>
        </span>
      </div>
    </div>
  </div>
</section>

<section class="section has-background-light">
  <div class="container">
    <div class="columns is-centered">
      <div class="column is-half has-text-centered">
        <h2 class="title is-4">Start Your Journey Today!</h2>
        <p class="content">
          Sign up to create your personalized adventure map or log in to continue exploring.
        </p>
        <a href="/signup" class="button is-primary is-medium">Get Started</a>
      </div>
    </div>
  </div>
</section>
