<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <!-- Bulma CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
    <!-- Font Awesome -->
    <script src="https://use.fontawesome.com/releases/v5.15.4/js/all.js"></script>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""/>
    <!-- Custom Styles -->
    <style>
      /* Map Styles */
      #map { 
        height: 400px; 
        margin: 1rem 0;
        border-radius: 8px;
        border: 1px solid #ddd;
      }
      .leaflet-container { 
        z-index: 0; /* Ensures map stays behind other elements */
      }
      
      /* Select Dropdown Fixes */
      .select {
        position: relative;
        z-index: 2;
      }
      .select select {
        display: inline-flex !important;
        width: 100%;
        cursor: pointer;
        min-height: 2.5em;
      }
      .select:not(.is-multiple):not(.is-loading)::after {
        border-color: #3273dc;
        right: 1.125em;
        z-index: 4;
      }
      
      /* Form Controls */
      .control {
        position: relative;
      }
      
      /* Other styles */
      .map-coordinates {
        background: white;
        padding: 5px 10px;
        border-radius: 4px;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
        margin-top: 10px;
      }
      
      /* Ensures dropdown appears above other content */
      .dropdown-content {
        z-index: 10 !important;
      }
    </style>
  </head>
  <body>
    <div class="container">
      {{{content}}}
      {{> error }}
    </div>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""></script>
      
    <!-- Optional: Simple script to ensure selects work -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Ensure all selects are properly initialized
        const selects = document.querySelectorAll('select');
        selects.forEach(select => {
          select.style.display = 'inline-flex';
        });
      });
    </script>
  </body>
</html>