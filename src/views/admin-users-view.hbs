{{> menu active="admin" }}

<section class="section">
  <div class="container">
    <h1 class="title">Admin: User Management</h1>
    <!-- Users table -->
    <table class="table is-fullwidth">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}
        <tr>
          <td>{{this.firstName}} {{this.lastName}}</td>
          <td>{{this.email}}</td>
          <td>
            <span class="tag {{#if (eq this.role 'admin')}}is-danger{{else}}is-light{{/if}}">
              {{this.role}}
            </span>
          </td>
          <td>
            <div class="buttons">
              {{#unless (eq this.role 'admin')}}
                <form action="/admin/users/{{this._id}}/promote" method="POST">
                  <button class="button is-success is-small" type="submit">
                    <span class="icon">
                      <i class="fas fa-user-shield"></i>
                    </span>
                    <span>Promote</span>
                  </button>
                </form>
              {{/unless}}

              {{#unless (eq ../user._id this._id)}}
                <form action="/admin/users/{{this._id}}/delete" method="POST">
                  <button class="button is-danger is-small" type="submit">
                    <span class="icon">
                      <i class="fas fa-trash"></i>
                    </span>
                    <span>Delete</span>
                  </button>
                </form>
              {{else}}
                <span class="tag is-info">
                  <span class="icon">
                    <i class="fas fa-user"></i>
                  </span>
                  <span>You</span>
                </span>
              {{/unless}}
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>