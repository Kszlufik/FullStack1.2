<form action="/dashboard/addpoi" method="POST">
  <div class="field">
    <label class="label">POI Title</label>
    <input class="input" type="text" placeholder="Enter POI title" name="title" required>
  </div>
  <div class="field">
    <label class="label">Category</label>
    <input class="input" type="text" placeholder="Enter Category" name="category" required>
  </div>
  <div class="field">
    <label class="label">Description</label>
    <input class="input" type="text" placeholder="Enter POI description" name="description">
  </div>
  <div class="field">
    <label class="label">Latitude</label>
    <input class="input" type="text" placeholder="Enter Latitude" name="latitude">
  </div>
  <div class="field">
    <label class="label">Longitude</label>
    <input class="input" type="text" placeholder="Enter Longitude" name="longitude">
  </div>
  <button class="button is-link">Add POI</button>
</form>
