<form class="box" action="/poi/{{poi._id}}/addmarker" method="POST" enctype="multipart/form-data">
  <label>Enter Marker Details:</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <label class="label">Title</label>
        <div class="control">
          <input class="input" type="text" placeholder="Enter Title" name="title" required>
        </div>
      </div>
      <div class="field">
        <label class="label">Description</label>
        <div class="control">
          <input class="input" type="text" placeholder="Enter Description" name="description" required>
        </div>
      </div>
      <div class="field">
        <label class="label">Latitude</label>
        <div class="control">
          <input class="input" type="number" step="any" placeholder="Enter Latitude" name="latitude" required>
        </div>
      </div>
      <div class="field">
        <label class="label">Longitude</label>
        <div class="control">
          <input class="input" type="number" step="any" placeholder="Enter Longitude" name="longitude" required>
        </div>
      </div>
    </div>
  </div>

  
  <div class="field">
    <div class="control">
      <button class="button is-primary" type="submit">Add Marker</button>
    </div>
  </div>
</form>