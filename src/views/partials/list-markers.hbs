{{! creates a full-width table to display markers }}
<table class="table is-fullwidth">
  {{! table header row with column titles }}
  <thead>
    <tr>
      <th>title</th>
      <th>description</th>
      <th>latitude</th>
      <th>longitude</th>
      <th></th> 
    </tr>
  </thead>

  {{! table body with marker data }}
  <tbody>
    {{! loops through each marker in the poi }}
    {{#each poi.markers}}
      <tr>
        {{! marker title }}
        <td>{{title}}</td>
        {{! marker description }}
        <td>{{description}}</td>
        {{! gps coordinates }}
        <td>{{latitude}}</td>
        <td>{{longitude}}</td>
        <td>
          {{! delete button with icon }}
          <a href="/poi/{{../poi._id}}/deletemarker/{{_id}}" class="ui icon button">
            <i class="fas fa-trash"></i> 
          </a>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>