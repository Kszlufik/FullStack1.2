{{! this creates a row to hold all the poi cards }}
<div class="row">
  {{! loops through each poi in the pois array }}
  {{#each pois}}
    {{! each poi gets a column that takes up 1/3 of the row on medium screens }}
    <div class="col-md-4">
      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <h5 class="card-title">{{this.title}}</h5>
          <p class="card-text">{{this.category}}</p>
          <a href="/poi/{{this._id}}" class="btn btn-primary">view poi</a>
        </div>
      </div>
    </div>
  {{/each}}
</div>